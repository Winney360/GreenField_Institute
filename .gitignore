# ---------------------------------------------------------------
# Greenfield Institute — files git should ignore
# ---------------------------------------------------------------

# Operating-system junk -----------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor / IDE folders ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# PHP -----------------------------------------------------------
vendor/
composer.lock
*.log

# Environment / local secrets -----------------------------------
.env
.env.local

# Real DB credentials live in includes/config.php — not tracked.
# Use includes/config.example.php as the template; copy it to config.php
# and fill in your own values.
includes/config.php

# XAMPP / runtime -----------------------------------------------
*.tmp
*.bak
greenfield.zip
