# ---------------------------------------------------------------
# Greenfield Institute — files git should ignore
# ---------------------------------------------------------------

# Operating-system junk -----------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor / IDE folders ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# PHP -----------------------------------------------------------
vendor/
composer.lock
*.log

# Environment / local secrets -----------------------------------
.env
.env.local

# If you ever decide to keep DB credentials private, uncomment
# the next line and create a public includes/config.example.php
# instead:
# includes/config.php

# XAMPP / runtime -----------------------------------------------
*.tmp
*.bak
